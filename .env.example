# MongoDB Atlas Sandbox (event cluster)
MONGODB_URI_RW=      # readWrite on ratchet_* and ratchet_scratch_* DBs
MONGODB_URI_RO=      # read on sample_* DBs
RATCHET_NS=a         # a | b | c for development; main for the final run

# Models (provider:model). Fill in the IDs you actually have access to.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=      # optional: cross-model critic + transfer test
GOOGLE_API_KEY=      # optional
VOYAGE_API_KEY=      # only if Atlas automated embeddings aren't available
RATCHET_PLANNER_MODEL=anthropic:claude-haiku-5-5
RATCHET_CRITIC_MODEL=anthropic:claude-sonnet-5-5
RATCHET_PROPOSER_MODEL=anthropic:claude-sonnet-5-5
