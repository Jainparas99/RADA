{
  "id": "mflix_w03",
  "split": "train",
  "db": "sample_mflix",
  "collections": [
    "movies"
  ],
  "baseline_indexes": {
    "movies": [
      {
        "keys": [
          [
            "genres",
            1
          ]
        ],
        "name": "genres_1"
      },
      {
        "keys": [
          [
            "type",
            1
          ]
        ],
        "name": "type_1"
      }
    ]
  },
  "write_rate": {
    "movies": 2.0
  },
  "index_budget": {
    "movies": 4
  },
  "queries": [
    {
      "id": "q1",
      "kind": "aggregate",
      "collection": "movies",
      "pipeline": [
        {
          "$unwind": "$genres"
        },
        {
          "$match": {
            "genres": "Horror",
            "year": {
              "$gte": 2005
            }
          }
        },
        {
          "$group": {
            "_id": "$year",
            "n": {
              "$sum": 1
            }
          }
        },
        {
          "$sort": {
            "_id": 1
          }
        }
      ],
      "freq": 10
    },
    {
      "id": "q2",
      "kind": "find",
      "collection": "movies",
      "filter": {
        "cast": "Tom Hanks"
      },
      "freq": 20,
      "sort": [
        [
          "year",
          1
        ],
        [
          "_id",
          1
        ]
      ],
      "projection": {
        "title": 1,
        "year": 1
      }
    },
    {
      "id": "q3",
      "kind": "find",
      "collection": "movies",
      "filter": {
        "awards.wins": {
          "$gte": 50
        }
      },
      "freq": 8,
      "sort": [
        [
          "awards.wins",
          -1
        ],
        [
          "_id",
          1
        ]
      ],
      "limit": 20,
      "projection": {
        "title": 1,
        "awards.wins": 1
      }
    },
    {
      "id": "q4",
      "kind": "find",
      "collection": "movies",
      "filter": {
        "tomatoes.viewer.rating": {
          "$gte": 4.5
        },
        "tomatoes.viewer.numReviews": {
          "$gte": 1000
        }
      },
      "freq": 4,
      "sort": [
        [
          "_id",
          1
        ]
      ],
      "projection": {
        "title": 1
      }
    },
    {
      "id": "q5",
      "kind": "aggregate",
      "collection": "movies",
      "pipeline": [
        {
          "$match": {
            "languages": "Japanese",
            "year": {
              "$gte": 2000,
              "$lt": 2010
            }
          }
        },
        {
          "$sort": {
            "imdb.votes": -1,
            "_id": 1
          }
        },
        {
          "$limit": 10
        },
        {
          "$project": {
            "title": 1,
            "imdb.votes": 1
          }
        }
      ],
      "freq": 6
    }
  ],
  "notes": "$unwind before $match (pre-filter on genres possible); multikey cast; in-memory sorts; type_1 unused"
}
