# Team env for the hackathon demo (Groq free tier + event Atlas sandbox).
#   cp .env.team.example .env      then fill in the three secrets Allen sends you privately.
# Never commit .env (it is gitignored).

# MongoDB Atlas sandbox: ask Allen (same URI for both lines is fine)
MONGODB_URI_RW=
MONGODB_URI_RO=
# Your own namespace: a | b | c (main only for the final team run)
RATCHET_NS=c

# Groq free tier: ask Allen. Limits are per Groq account (~30 requests/min, daily token caps),
# so don't run big jobs (eval / evolve) on two machines at once.
GROQ_API_KEY=
RATCHET_PLANNER_MODEL=groq:openai/gpt-oss-120b
RATCHET_CRITIC_MODEL=groq:qwen/qwen3.8-27b
RATCHET_PROPOSER_MODEL=groq:openai/gpt-oss-120b
